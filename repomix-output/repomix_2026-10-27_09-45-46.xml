              </p>
            </div>
          </div>

          <div className="space-y-5">
            {/* Amount Invested */}
            <div>
              <label htmlFor="roi-inv" className="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-1">
                {t.amountInvested} ({currencySymbol})
              </label>
              <input
