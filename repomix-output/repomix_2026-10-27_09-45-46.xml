                    {/* Center Point */}
                    <circle cx={sectorSvgPath.cx} cy={sectorSvgPath.cy} r="4" fill="#006a5a" />
                    <text x={sectorSvgPath.cx - 15} y={sectorSvgPath.cy + 18} className="text-[11px] font-bold fill-stone-600">O (Center)</text>
