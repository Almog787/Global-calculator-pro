        </div>

        {/* Results & Visual Chart Column */}
        <div className="lg:col-span-5 space-y-6">
          <div className="bg-surface-container-lowest border border-border-subtle rounded-3xl p-6 sm:p-8 space-y-6 shadow-sm">
