              <div
                className="h-full bg-emerald-500 transition-all duration-300"
                style={{
                  width: `${Math.min(100, Math.max(0, (calcResult.gestationalWeeks / 13) * 100))}%`,
                }}
              />
            </div>
            {/* Tri 2: weeks 14-27 (14/40 = 35%) */}
