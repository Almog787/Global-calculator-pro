    {
      label: lang === 'he' ? 'תיק אג"ח סולידי (4% ל-3 שנים)' : 'Conservative Bond (3 Yrs at 4%)',
      values: { amountInvested: 200000, amountReturned: 225000, investmentLength: 3 }
    },
  ];

  return (
    <div className="w-full max-w-7xl mx-auto space-y-8">
      <SEO
        title={t.title}
