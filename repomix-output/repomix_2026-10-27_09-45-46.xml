<file path="src/index.css">
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --brand-primary: #006b5b;
    --brand-accent: #10b981;
    --brand-radius: 16px;
  }

  body {
    @apply bg-surface-bg text-on-surface font-body-md min-h-screen flex flex-col antialiased selection:bg-secondary/20 selection:text-secondary;
    font-variant-numeric: tabular-nums;
  }
}

/* Embed Mode Theme Overrides */
.is-embed-mode {
  min-height: 100vh;
}

.is-embed-mode .bg-secondary,
.is-embed-mode button.bg-secondary {
  background-color: var(--brand-primary, #006b5b) !important;
}

.is-embed-mode .text-secondary,
.is-embed-mode a.text-secondary {
  color: var(--brand-primary, #006b5b) !important;
}

.is-embed-mode .border-secondary {
  border-color: var(--brand-primary, #006b5b) !important;
}

.is-embed-mode .focus\:ring-secondary:focus {
  --tw-ring-color: var(--brand-primary, #006b5b) !important;
}

.is-embed-mode .bg-secondary\/10 {
  background-color: color-mix(in srgb, var(--brand-primary, #006b5b) 10%, transparent) !important;
}

.is-embed-mode .bg-secondary\/20 {
  background-color: color-mix(in srgb, var(--brand-primary, #006b5b) 20%, transparent) !important;
}

.is-embed-mode .rounded-2xl,
.is-embed-mode .rounded-3xl {
  border-radius: var(--brand-radius, 16px);
}


.material-symbols-outlined {
  font-family: 'Material Symbols Outlined';
  font-weight: normal;
  font-style: normal;
  font-size: 24px;
  line-height: 1;
  letter-spacing: normal;
  text-transform: none;
  display: inline-block;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  -webkit-font-feature-settings: 'liga';
  -webkit-font-smoothing: antialiased;
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}

.material-symbols-outlined.filled {
  font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}

.ambient-shadow {
  box-shadow: 0 4px 20px rgba(0, 27, 61, 0.04);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.ambient-shadow:hover {
  box-shadow: 0 8px 30px rgba(0, 27, 61, 0.08);
  transform: translateY(-2px);
}

.input-focus-ring:focus-within {
  border-color: #006b5b;
  box-shadow: 0 0 0 3px #00F5D433;
}

.scrollbar-hide::-webkit-scrollbar { display: none; }
.scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

/* Custom Motion & Spring Animations for Calc-E & React Bits */
@keyframes gradientMove {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.animate-shimmer {
  background: linear-gradient(
    90deg,
    currentColor 0%,
    rgba(255, 255, 255, 0.8) 50%,
    currentColor 100%
  );
  background-size: 200% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: shimmer 3s infinite linear;
}

@keyframes popInSpring {
  0% { transform: scale(0); opacity: 0; }
  60% { transform: scale(1.08); opacity: 1; }
  80% { transform: scale(0.96); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.animate-pop-in-spring {
  animation: popInSpring 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes slideUpFade {
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0); }
}

.animate-slide-up-fade {
  animation: slideUpFade 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes starMovementBottom {
  0% { transform: translate(0%, 0%); opacity: 1; }
  100% { transform: translate(-100%, 0%); opacity: 0; }
}

@keyframes starMovementTop {
  0% { transform: translate(0%, 0%); opacity: 1; }
  100% { transform: translate(100%, 0%); opacity: 0; }
}

.animate-star-movement-bottom {
  animation: starMovementBottom linear infinite alternate;
}

.animate-star-movement-top {
